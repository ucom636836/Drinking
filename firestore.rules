rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 驗證版(建議):必須先以公司共用帳號登入(見 README「限制存取」)
    match /orders/{id} { allow read, write: if request.auth != null; }
    match /stores/{id} { allow read, write: if request.auth != null; }

    // 開放版(不設密碼):把上面兩段改成 `if true;` 即可
  }
}
